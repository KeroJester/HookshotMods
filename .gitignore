# Game files never live here: the builders read the game folder (HOOKSHOT_GAME_DIR, or the one the mod
# manager uses) and write mods into it. Never copy game data, ROMs, saves or memory dumps into this repo.
__pycache__/
*.pyc
*.o
*.so
*.dll
*.exe
*.log
*.mark

# Build outputs and caches
/mod_manager/cache/

# Dev overlay runtime files (memory dumps of the running game)
/overlay/*.bin
/overlay/goron_preview.png

# Local research checkouts (reference/hookshot-src: the Hookshot source, no longer published)
/reference/*
!/reference/README.txt

# App builds
/build/
/dist/
