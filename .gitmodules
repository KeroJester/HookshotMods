[submodule "imgui_src"]
	path = imgui_src
	url = https://github.com/ocornut/imgui.git
	ignore = dirty
[submodule "vulkan_headers_src"]
	path = vulkan_headers_src
	url = https://github.com/KhronosGroup/Vulkan-Headers.git
[submodule "reference/hookshot-src"]
	path = reference/hookshot-src
	url = https://github.com/NotRexed/Hookshot.git
[submodule "third_party/AINB"]
	path = third_party/AINB
	url = https://github.com/dt-12345/AINB.git
[submodule "third_party/zstd"]
	path = third_party/zstd
	url = https://github.com/facebook/zstd.git
